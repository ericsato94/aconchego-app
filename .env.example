# Copie para .env e preencha. O .env nunca vai para o Git.

# ElevenLabs (servidor)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4

# Supabase — servidor (chave de serviço: NUNCA no app/navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — app (chave pública/publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Quem pode criar voz clonada (gasta créditos): e-mails separados por vírgula; "*" = todos
VOICE_ALLOWED_EMAILS=

# Painel do quiz (/admin): login validado no servidor
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Segredo para assinar a sessão do painel (mínimo 32 caracteres aleatórios)
ADMIN_SESSION_SECRET=
# Chave do aviso de compra (POST /api/quiz/purchase). Aceita várias, separadas por vírgula (ex.: a da Cakto)
QUIZ_WEBHOOK_SECRET=
